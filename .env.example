# ---- Microsoft Foundry project ----
# Foundry portal (ai.azure.com) > your project > Overview > Endpoints
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>

# ---- Deployment names (as created in the Foundry portal) ----
CHAT_DEPLOYMENT=gpt-5.1
MULTIMODAL_DEPLOYMENT=gpt-5.1
IMAGE_DEPLOYMENT=gpt-image-1
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Agent (single-agent demo, Module 2c) ----
# The agent's NAME from the Foundry portal (Agents blade).
AGENT_NAME=wealth-concierge

# ---- Azure AI Speech (Demo 4) ----
SPEECH_REGION=eastus
# Keyless (AAD) Speech needs the Cognitive Services account resource ID:
SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
# Prefer keyless; only set a key for a quick classroom demo.
# SPEECH_KEY=

# ---- Azure AI Content Understanding (Demo 6, preview) ----
CONTENT_UNDERSTANDING_ENDPOINT=https://<your-resource>.services.ai.azure.com/
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01

# ---- Azure AI Language (Demo 3, Part C — PII detection) ----
# The multi-service Cognitive Services endpoint of the same Foundry account.
LANGUAGE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# ---- Auth ----
# Leave keys blank to use DefaultAzureCredential (az login / managed identity).
# AZURE_AI_API_KEY=
